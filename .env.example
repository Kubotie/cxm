# ─── CXM 環境変数のテンプレート ───────────────────────────────────────────────
#
# このファイルは **キー名だけ** を管理する。値は絶対に書かない（public リポジトリ）。
# 実際の値は 1Password か `vercel env pull .env.local` で受け取ること。
#
# 使い方:
#   cp .env.example .env.local     # そのあと値を埋める
#
# ⚠️ 新しい機能でキーを増やしたら、**必ずこのファイルにも追記して commit する。**
#    NocoDB のテーブル ID は未設定でもエラーにならず「機能ごと静かに無効化」される
#    （graceful degradation）ので、増えたことに他のメンバーが気づけない。
#    ここに書いておけば git diff に出る。

# ── 必須: NocoDB（**CXM** の業務データの正本。継続利用する）────────────────
#   CXM は今後も NocoDB を主要データストアとして使う。Twenty 集約の対象ではない。
#   PtAI Pipeline だけが Twenty へ集約する（下の PTAI_DATA_SOURCE を参照）。
NOCODB_API_TOKEN=
NOCODB_BASE_URL=

# ── 必須: LLM（顧客理解・提案骨子・AI パネル・言質抽出）──────────────────────
OPENROUTER_API_KEY=
# 省略時は anthropic/claude-sonnet-4-5
# ANTHROPIC_MODEL=

# ── PtAI Pipeline の AI（/api/ptai/ai）────────────────────────────────────
# アーティファクトの window.claude.use('sample') の置き換え。
# 原本の実値は claude.ai のプラットフォーム内部で**確認できない**ため、
# 下の 2 つは移植側の決め打ち。根拠は src/app/api/ptai/ai/route.ts に書いてある。
#
# プロンプトの上限（バイト）。既定 180000。
#   原本は 65536（64 KiB）だが**揃えていない**。64 KiB はプラットフォームの制約で、
#   揃えると gatherSources の材料（日本語で約 60 KB）が落ちるため。
#   小さいコンテキストのモデルに替えるときはここで下げる。
# PTAI_AI_MAX_PROMPT_BYTES=
#
# Extended thinking に割くトークン数。既定 8000。**0 で無効**。
#   原本の modelTier:'default' は「書き始める前に考える」ので、既定は有効。
#   組織図とアカウントプランの構造の質に効く代わり、応答が約 2 倍かかる。
#   Claude 系モデルのときだけ付く（他モデルには送らない）。
# PTAI_AI_THINKING_BUDGET=

# ── 必須: Vercel Blob（AI チャット履歴・AI 設定・生成資料）──────────────────
BLOB_READ_WRITE_TOKEN=

# ── 認証 ────────────────────────────────────────────────────────────────────
# セッション Cookie（cxm_session）の HMAC-SHA256 署名鍵。**必須**。
#   未設定だとログインは 503、既存セッションもすべて無効になる（平文へフォールバックしない）。
#   32 バイト以上のランダム値。生成例:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#     openssl rand -base64 48
#   ローテーションすると全員が再ログインになる。
CXM_SESSION_SECRET=

# 個別パスワード未設定のユーザー向けの共有パスワード（移行中の経過措置）。
#   2026-09-30 の是正でソース上の既定値を撤去した。**未設定なら共有パスワードでは入れない**
#   （個別パスワード設定済みのユーザーは、この変数が無くてもログインできる）。
#   生成例:
#     node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
#   全員が個別パスワードへ移行し終えたら削除してよい。
APP_PASSWORD=

# 承認者ロール（PtAI Pipeline）。**既定は Utty と Kubotie の 2 人**（2026-10-01 §9-7）。
#   「契約締結済み」への出入りと、受注済み商談の変更・削除に承認が要る。
#   判定は src/lib/ptai/approver-policy.ts。サーバー側でも /api/ptai/db が確認する。
#   増減するときだけ設定する（カンマ区切り。設定すると既定は効かなくなる）。
# PGA_APPROVER_NAME2=Utty,Kubotie
#   メールで指定したいときはこちら（設定されていれば name2 より優先）。
# PGA_APPROVER_EMAILS=

# ── PtAI Pipeline の設定テーブル（2026-10-01）──────────────────────────────
# Twenty API キーを管理画面から設定するための PtAI 専用テーブル。
# 作成は scripts/ptai-settings-table.mjs --apply。
NOCODB_PTAI_SETTINGS_TABLE_ID=

# 上のテーブルに入れる値を暗号化する鍵。**必須**（未設定だと保存できない）。
#   NocoDB のトークンは CXM と共用でテーブル単位に絞れないため、平文では置かない。
#   この鍵は **Vercel にだけ**置く。DB が漏れても鍵が無ければ復号できない。
#   32 バイト以上のランダム値。生成例:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   ⚠ ローテーションすると保存済みの値が復号できなくなる。先にキーを再設定すること。
PTAI_SECRET_KEY=

# ── PtAI Pipeline の目標（Notion 専用 DB。2026-10-01 §9-1）──────────────────
# チーム目標・期限・メンバー別目標の正本。旧 pga_docs/settings の置き換え先。
# 親ページは「Ptengine AI Project Board（JP）」。作成は scripts/notion-targets-db.mjs。
# 読み書きには TOKEN_NOTION（または PGA_NOTION_TOKEN）を使う。
NOTION_PTAI_TARGETS_DB_ID=
# API 2025-09-03 では列は data source が持つ。問い合わせにはこちらを使う。
NOTION_PTAI_TARGETS_DS_ID=

# ── バッチ認証 ───────────────────────────────────────────────────────────────
#   production（VERCEL_ENV=production）では未設定だと 503 で拒否する。
#   ローカル開発では未設定なら認証をスキップする（警告のみ）。
#   ⚠️ NEXT_PUBLIC_ を付けてはいけない。付けるとクライアントバンドルに焼き込まれる。
CRON_SECRET=
SUPPORT_BATCH_SECRET=

# ── Twenty CRM（Phase 1: 読み取り専用の接続検証）────────────────────────────
# API のホストは **crm.ptengine.com**。2026-09-30 に実測で確定した。
#   https://crm.ptengine.com        → API（これが正しい）
#   https://crm.ptengine.com/api    → SPA の HTML が返る。API ではない
#   https://crm.ptmind.com          → フロントエンド。API パスも HTML
# 省略時は https://crm.ptengine.com。末尾スラッシュや誤った /api /rest /metadata は
# クライアントが正規化して剥がす（src/lib/twenty/client.ts の normalizeBaseUrl）。
TWENTY_API_URL=

# Phase 1 の **読み取り用途** の API キー（Bearer。OAuth ではない）。
# TWENTY_READ_API_KEY という名前でも読む（読み取り専用キーを別名で持つ場合の受け口）。
# 未設定でも /api/ops/twenty/health は 200 を返し、何が足りないかを示す。
#
# 🚨 **【2026-09-30 判明】Production に入っているのは Admin キー（書き込み可能）。**
#    当初「読み取り専用かは未確認（監査 Q17）」としていたが、利用者への確認で
#    **Admin キーであることが確定した。** Q17 は「未確認」ではなく「書き込み可能」。
#    アプリ側は client.ts が GET しか発行しないため現時点で事故は起きないが、
#    **コードを 1 行足せば本番 CRM を破壊できる状態**にある。
#    Twenty 側に監査ログ API は無く（/rest/auditLogs は 4xx）、復旧手順も未確認。
#
# ⚠️ **やること: 読み取り専用キーを別途発行し、この変数へ差し替える。**
#    Admin キーはアプリの環境変数に置かない。Preview にはキー自体が未設定。
# ⚠️ **書き込み用のキーをこの変数へ設定しないこと。**
#
# 2026-10-01: **管理画面（/ops/twenty）から設定できるようにした。**
#   保存先は PtAI 専用の ptai_settings（AES-256-GCM で暗号化）。
#   アプリは **DB → この環境変数** の順に解決するので、DB に入れたらこちらは不要。
#   staff_identify には置かない（共通認証のホットパスで、1 行＝1 人のため）。
#
# Phase 3（書き込み）の認証方式は**未確定**。次の 2 案を比較して決める。
#   a) 共有サービスキー ＋ アプリ側の監査ログ
#   b) 操作者ごとのキー
# どちらにするかは Q1（個人がキーを発行できるか）の回答待ち。
# **Pipeline 用キーの保存先として NocoDB を前提にしない。** 保存が要るかどうかも含めて未定。
TWENTY_API_KEY=

# ── PtAI Pipeline のデータ取得元（移行期間専用の Feature Flag）──────────────
# **PtAI Pipeline 専用。CXM の取得経路には一切影響しない。**
# PtAI Pipeline の業務データは Twenty を唯一の正本にする方針だが、
# 移行の比較期間だけ切り替えられるようにしてある。
#   legacy_nocodb  … Pipeline の pga_docs/_raw を返す（**現在の既定**。移植時の互換実装）
#   twenty         … Twenty から取得して RAW 互換に変換して返す（目標設計。pga_docs に保存しない）
# Phase 2B で Preview だけ twenty にして旧画面と比較する。
# Phase 2D でこのフラグごと削除する。**恒久的な二重正本にしないこと。**
PTAI_DATA_SOURCE=

# ── NocoDB テーブル ID ──────────────────────────────────────────────────────
# CSM コア
NOCODB_COMPANIES_TABLE_ID=
NOCODB_PROJECT_INFO_TABLE_ID=
NOCODB_PEOPLE_TABLE_ID=
NOCODB_COMPANY_PEOPLE_TABLE_ID=
NOCODB_COMPANY_ACTIONS_TABLE_ID=
NOCODB_ALERTS_TABLE_ID=
NOCODB_EVIDENCE_TABLE_ID=
NOCODB_AUDIT_LOGS_TABLE_ID=

# スナップショット / 事前計算
NOCODB_COMPANY_DAILY_SNAPSHOT_TABLE_ID=
NOCODB_PROJECT_METRICS_TABLE_ID=
NOCODB_PROJECT_USER_SNAPSHOTS_TABLE_ID=
NOCODB_CAMPAIGN_ORG_TABLE_ID=

# LLM 生成物のキャッシュ
NOCODB_COMPANY_PROFILE_TABLE_ID=
NOCODB_INDUSTRY_INTEL_TABLE_ID=

# 接点ログ
NOCODB_LOG_NOTION_MINUTES_TABLE_ID=
NOCODB_LOG_CHATWORK_TABLE_ID=
NOCODB_LOG_SLACK_TABLE_ID=
NOCODB_LOG_INTERCOM_TABLE_ID=
NOCODB_CSE_TICKETS_TABLE_ID=

# 提案フロー
NOCODB_EXTERNAL_INTEL_TABLE_ID=
NOCODB_COMPANY_SITUATIONS_TABLE_ID=
NOCODB_PROPOSAL_OUTLINES_TABLE_ID=

# 解約レーダー（2026-09 追加。未設定だと /v2/radar が黙って空になる）
NOCODB_CHURN_RADAR_STATE_TABLE_ID=
NOCODB_CHURN_RADAR_EVENTS_TABLE_ID=
NOCODB_CHURN_RADAR_VOICE_TABLE_ID=

# フェーズ / ユーザー / チャネル
#   NOCODB_STAFF_IDENTIFY_TABLE_ID は**共通認証**（ログインとロール判定）で使う。
#   顧客の業務データではないので、Twenty 集約の対象外。移行後も残る。
NOCODB_CSM_CUSTOMER_PHASE_TABLE_ID=
NOCODB_CRM_CUSTOMER_PHASE_TABLE_ID=
NOCODB_STAFF_IDENTIFY_TABLE_ID=
NOCODB_COMPANY_CHANNEL_IDENTIFY_TABLE_ID=

# 旧 UI（v2 では未使用。無くても /v2 は動く）
NOCODB_SUPPORT_ALERTS_TABLE_ID=
NOCODB_SUPPORT_CASE_AI_STATE_TABLE_ID=
NOCODB_UNIFIED_LOG_SIGNAL_STATE_TABLE_ID=
NOCODB_COMPANY_SUMMARY_STATE_TABLE_ID=
NOCODB_OUTBOUND_CAMPAIGNS_TABLE_ID=
NOCODB_OUTBOUND_AUDIENCES_TABLE_ID=
NOCODB_CSM_ASSETS_TABLE_ID=
NOCODB_CSM_DOCUMENTS_TABLE_ID=

# PtAI Pipeline 専用（collection/doc_id/JSON）。
#   **このリストで唯一、将来の削除候補。** Pipeline を Twenty へ集約し終えたら不要になる。
#   他の NOCODB_*_TABLE_ID は CXM が使い続けるので削除しない。
NOCODB_PGA_DOCS_TABLE_ID=

# ── 外部サービス（v2 の主要画面には不要）────────────────────────────────────
TOKEN_NOTION=
TOKEN_NOTION_2=
TOKEN_INTERCOM=
OPENAI_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=
SALESFORCE_API_VERSION=

# VERCEL_OIDC_TOKEN は `vercel env pull` が自動生成するので手で書かない
